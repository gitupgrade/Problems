#include <bits/stdc++.h>

using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        int maxl = 0;
        vector<int> v;

        cin >> n;
        int odd = 0, even = 0;

        for (int i = 0; i < n; i++)
        {
            int x;
            cin >> x;

            if (x % 2 == 0)
                even++;
            else
                odd++;
        }
        int ans = 2 * min(odd, even);

        if (odd != even)
            ans++;
        cout << ans << endl;
    }

}
