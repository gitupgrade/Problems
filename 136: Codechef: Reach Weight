#include <bits/stdc++.h>
using namespace std;

int main() {
	 int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        cin>>n;
        int d=n/2;
        int ans1=d*30;
        int ans2=(n-d*2)*20;
        int ans=ans1+ans2;
        cout<<ans<<endl;
    }
    

}
