#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        cin >> n;
        vector<int> a;
        int odd=0;
        int even1=0;
        int even2=0;

        for (int i = 0; i < n; i++)
        {   int x;
            cin >> x;
            a.push_back(x);
            if(x%2==1)
            {
                odd=odd+1;
            }
            else{
                if(x%4==0)
                {
                    even1+=1;
                }
                else{
                    even2+=1;
                }
            }
        }
        int ans = max({odd, even1, even2});
        cout<<ans<<endl;
    }
}
