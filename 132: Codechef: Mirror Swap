#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        vector<int> v;
         v.push_back(0);
        cin >> n;
        int a = (2 * n)+1;
        for (int i = 1; i <= (2 * n); i++)
        {
            int x;
            cin >> x;
            v.push_back(x);
        }
        
        for (int j = 1; j <=n; j++)
        {
            if (v[j] < v[a  - j])
            {
                swap(v[j], v[a - j]);
            }
        }
        

        
        int sum = accumulate(v.begin() + 1, v.begin() + n + 1, 0);
        cout << sum << endl;
    }
}
