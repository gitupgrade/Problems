#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        int k;
        cin >> n >> k;
        string s;
        cin >> s;
       
        int start = 0;

        int ans = 0;

        for (int start = 0; start < n; start += k)
        {

            for (int j = start; j < start + k; j++)
            {
                if (s[j] == '0')
                    break;

                if (j == start + k - 1)
                    ans++;
            }
        }
        cout << ans << endl;
    }
}
