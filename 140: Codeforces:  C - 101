#include <bits/stdc++.h>
using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t-- > 0)
    {
        int n;
        cin >> n;
        vector<int> a;
        for (int i = 0; i < n; i++)
        {
            int x;
            cin >> x;
            a.push_back(x);
        }
        for (int i = 0; i < n; i++)
        {   if (a[i] == 1)
            {
                break;
            }
            if (a[i] == -1)
            {
                a[i] = 1;
                break;
            }
        }
        for (int i = (n - 1); i >= 0; i--)
        {    if (a[i] == 1)
            {
                break;
            }
            if (a[i] == -1)
            {
                a[i] = 1;
                break;
            }
        }
        for (int i = 0; i < n; i++)
        {
            if (a[i] == -1)
            {
                a[i] = 0;
                
            }
        }
        for (int i = 0; i < n; i++)
        {
            cout << a[i] << " ";
        }
         cout << '\n';
    }
   
}
